PORT=3001
HOST=0.0.0.0
# Frontend origin(s) for Express + Socket.IO CORS (comma-separated).
# Production must list every deployed frontend explicitly (dev LAN auto-allow
# does not apply when NODE_ENV=production|staging).
# Example (local + LAN Vite + Vercel):
CLIENT_ORIGIN=http://localhost:5173,http://192.168.0.104:5173,https://wheelwin-nine.vercel.app
NODE_ENV=development
EVENT_BUS_LOGGING=true
LOG_LEVEL=info
# R7.0D — Production logging (file logging on by default outside development)
LOG_DIRECTORY=logs
LOG_MAX_FILE_SIZE_MB=10
LOG_MAX_FILES=10
LOG_MAX_AGE_DAYS=14
LOG_FORMAT=console
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=false
METRICS_ENABLED=false
# R7.0E — Monitoring & metrics
MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL_MS=1000
RUNTIME_COLLECTION_INTERVAL_MS=1000
SIMULATION_COLLECTION_INTERVAL_MS=500
PAYMENT_COLLECTION_INTERVAL_MS=5000
RECOVERY_COLLECTION_INTERVAL_MS=5000
SYSTEM_COLLECTION_INTERVAL_MS=5000
PROMETHEUS_ENABLED=false
PROMETHEUS_PATH=/metrics
# PROMETHEUS_PORT=9090
# R7.0F — Failure recovery policies
FAILURE_POLICY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=200
RETRY_MAX_DELAY_MS=30000
BACKOFF_STRATEGY=exponential_jitter
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_MS=30000
CIRCUIT_SUCCESS_THRESHOLD=2
FAILURE_HISTORY_LIMIT=100
# R7.0G — Production health / readiness / deployment probes
HEALTH_ENABLED=true
READINESS_ENABLED=true
LIVENESS_ENABLED=true
STARTUP_PROBE_ENABLED=true
# PROBE_REFRESH_INTERVAL_MS=2000
# DEPLOYMENT_PROFILE=development
# R8.0B — Release build system
RELEASE_CHANNEL=development
RELEASE_OUTPUT_DIRECTORY=release
RELEASE_SIGNING_ENABLED=false
RELEASE_GENERATE_CHECKSUMS=true
RELEASE_INCLUDE_DOCS=true
RELEASE_INCLUDE_REPORTS=true

# R8.0D — Closed Beta operations (observational)
CLOSED_BETA_ENABLED=true
CLOSED_BETA_REQUIRE_CERTIFICATION=true
CLOSED_BETA_MAX_PARTICIPANTS=500

# R8.0E — Launch readiness (observational)
LAUNCH_READINESS_ENABLED=true
LAUNCH_REQUIRE_MAINNET_FOR_GA=true

# R9.0A — General Availability orchestration (observational)
GA_RELEASE_ENABLED=true
GA_ROLLOUT_MODE=single
GA_VERIFY_AFTER_RELEASE=true
GA_POST_LAUNCH_MONITORING_HOURS=72
GA_REQUIRE_CERTIFICATION=true

# R9.0B — Post-launch operations (observational)
OPERATIONS_ENABLED=true
SLA_AVAILABILITY_TARGET=0.995
SLA_LATENCY_TARGET_MS=250
SLA_RECOVERY_TARGET=0.95
MAINTENANCE_DEFAULT_DURATION_MINUTES=60
VERSION_SUPPORT_WINDOW_DAYS=90

# R9.0C — Platform governance (observational)
GOVERNANCE_ENABLED=true
AUDIT_INTERVAL_DAYS=30
COMPLIANCE_REQUIRED=true
RISK_REVIEW_INTERVAL_DAYS=30
EVIDENCE_RETENTION_DAYS=365
PLATFORM_REVIEW_INTERVAL_DAYS=90
STARTUP_DEMONSTRATIONS=true
# R7.0B — max ms to wait for in-flight work during graceful drain (default 30000)
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
ROOM_MAX_PLAYERS=3
# Owner wallet (Railway / production). When set, config/owner.json is not required.
# OWNER_WALLET=EQ...
# R6.1 — Application environment (DEVELOPMENT | TESTNET | MAINNET).
# Persisted switches from the dashboard override this after restart.
APP_ENVIRONMENT=DEVELOPMENT
TON_NETWORK=testnet
TON_API_KEY=
TON_ENDPOINT=
TON_DEPLOY_MODE=stub
# R7.67A — Testnet default is game when unset. Set v4 for explicit rollback.
# Mainnet default remains v4 (do not enable game on mainnet without a dedicated rollout).
GAME_ESCROW_MODE=game
TON_DEPLOYER_MNEMONIC=
# R17.9L.14 — Dedicated TESTNET-ONLY Deposit Contract deployer.
# NEVER set this to TON_DEPLOYER_MNEMONIC / WheelWin Deploy Wallet.
# TON_TESTNET_DEPOSIT_DEPLOYER_MNEMONIC=
# TON_TESTNET_DEPOSIT_DEPLOYER_EXPECTED_ADDRESS=EQ...
# R7.67B — Optional. When set with TON_DEPLOYER_MNEMONIC, startup fails on address mismatch.
# TON_DEPLOYER_EXPECTED_ADDRESS=EQ...
# R7.70A.2 — Temporary Testnet oracle (public address). Prefer dedicated key:
# TON_TESTNET_ORACLE_ADDRESS=EQ...
# Fallback: TON_ORACLE_ADDRESS / GAME_ESCROW_ORACLE
TON_ORACLE_ADDRESS=
TON_GRM_JETTON_MASTER=
TON_POLL_INTERVAL_MS=2000

# R17.8V.2P.H — Deployment cost snapshot persistence (Stage A). Keep false until capture wiring.
# DEPLOYMENT_COST_SNAPSHOT_ENABLED=false

# R17.8V.2P.M / O / Q — Deployment reimbursement. Keep disabled until production readiness.
# DEPLOYMENT_REIMBURSEMENT_ENABLED=false
# REIMBURSEMENT_ENABLED=false
# REIMBURSEMENT_MAX_TRANSFER=0.05
# REIMBURSEMENT_DAILY_LIMIT=1
# REIMBURSEMENT_WALLET_RESERVE=0.05
# TON_REIMBURSEMENT_EXPECTED_ADDRESS=EQ...   # address pin only
# TON_REIMBURSEMENT_MNEMONIC=                 # Railway secret only; never commit / never log

# R7.68 / R8.1B — Mainnet readiness profile (does NOT enable Mainnet; keep TON_NETWORK=testnet).
# Use the existing Railway mnemonic → WalletContractV4R2 identity (do NOT create a new wallet).
# Set oracle + expected deployer to the SAME verified bounceable address (no fallback / guessing).
# TON_MAINNET_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
# TON_MAINNET_ORACLE_ADDRESS=EQ...   # must equal deployer expected address
# TON_MAINNET_DEPLOYER_EXPECTED_ADDRESS=EQ...   # pin from Railway mnemonic derivation
# TON_MAINNET_GAME_ESCROW_MODE=v4
# TON_GAME_ESCROW_ARTIFACT_SHA256=<sha256 of server/payment/ton/artifacts/GameEscrow.code.boc>
# TON_MAINNET_DRY_RUN_DEBUG=true
# TON_MAINNET_WALLET_IDENTITY_DEBUG=true
# Validate: node server/scripts/check-mainnet-readiness.js

# R7.0C — In production/staging: use strong unique secrets (not these examples).
# DEVELOPER_AUTH_ENABLED must remain true; insecure defaults are rejected.
DEVELOPER_AUTH_ENABLED=true
DEVELOPER_AUTH_SECRET=change-me-developer-console-secret
# R6.1 — Administrator credentials (required for staging/production).
# Generate hash: node server/scripts/hash-admin-password.js "your-password"
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt:...
# Optional read-only dashboard account:
# VIEWER_USERNAME=viewer
# VIEWER_PASSWORD_HASH=scrypt:...
# Development-only fallback (never use in staging/production):
DEVELOPER_AUTH_USERNAME=developer
DEVELOPER_AUTH_PASSWORD=developer
DEVELOPER_AUTH_ACCESS_TTL_SECONDS=900
DEVELOPER_AUTH_REFRESH_TTL_SECONDS=28800
# TRUST_PROXY=true
# APP_ENVIRONMENT=DEVELOPMENT
# BLOCKCHAIN_NETWORK=TESTNET

# R17.8V.1C — Testnet ValueTon override (measurement only; never enable in production).
# TEST_VALUETON_OVERRIDE=true
# TEST_VALUETON_DEPLOY=0.05
# TEST_VALUETON_INIT=0.05
# TEST_VALUETON_OPEN=0.05
# TEST_VALUETON_CANCEL=0.05
# TEST_VALUETON_SETTLE=0.05
# RUN_TESTNET_VALUETON_SWEEP=true
# TEST_VALUETON_SWEEP_VALUES=0.05,0.04,0.03,0.025,0.02,0.015,0.01
# TEST_VALUETON_SCENARIOS=A,B,C
# TEST_VALUETON_STAKE_TON=0.05
