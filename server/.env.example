PORT=3001
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
EVENT_BUS_LOGGING=true
LOG_LEVEL=info
# R7.0D — Production logging (file logging on by default outside development)
LOG_DIRECTORY=logs
LOG_MAX_FILE_SIZE_MB=10
LOG_MAX_FILES=10
LOG_MAX_AGE_DAYS=14
LOG_FORMAT=console
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=false
METRICS_ENABLED=false
# R7.0E — Monitoring & metrics
MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL_MS=1000
RUNTIME_COLLECTION_INTERVAL_MS=1000
SIMULATION_COLLECTION_INTERVAL_MS=500
PAYMENT_COLLECTION_INTERVAL_MS=5000
RECOVERY_COLLECTION_INTERVAL_MS=5000
SYSTEM_COLLECTION_INTERVAL_MS=5000
PROMETHEUS_ENABLED=false
PROMETHEUS_PATH=/metrics
# PROMETHEUS_PORT=9090
# R7.0F — Failure recovery policies
FAILURE_POLICY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=200
RETRY_MAX_DELAY_MS=30000
BACKOFF_STRATEGY=exponential_jitter
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_MS=30000
CIRCUIT_SUCCESS_THRESHOLD=2
FAILURE_HISTORY_LIMIT=100
# R7.0G — Production health / readiness / deployment probes
HEALTH_ENABLED=true
READINESS_ENABLED=true
LIVENESS_ENABLED=true
STARTUP_PROBE_ENABLED=true
# PROBE_REFRESH_INTERVAL_MS=2000
# DEPLOYMENT_PROFILE=development
# R8.0B — Release build system
RELEASE_CHANNEL=development
RELEASE_OUTPUT_DIRECTORY=release
RELEASE_SIGNING_ENABLED=false
RELEASE_GENERATE_CHECKSUMS=true
RELEASE_INCLUDE_DOCS=true
RELEASE_INCLUDE_REPORTS=true

# R8.0D — Closed Beta operations (observational)
CLOSED_BETA_ENABLED=true
CLOSED_BETA_REQUIRE_CERTIFICATION=true
CLOSED_BETA_MAX_PARTICIPANTS=500

# R8.0E — Launch readiness (observational)
LAUNCH_READINESS_ENABLED=true
LAUNCH_REQUIRE_MAINNET_FOR_GA=true

# R9.0A — General Availability orchestration (observational)
GA_RELEASE_ENABLED=true
GA_ROLLOUT_MODE=single
GA_VERIFY_AFTER_RELEASE=true
GA_POST_LAUNCH_MONITORING_HOURS=72
GA_REQUIRE_CERTIFICATION=true
STARTUP_DEMONSTRATIONS=true
# R7.0B — max ms to wait for in-flight work during graceful drain (default 30000)
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
ROOM_MAX_PLAYERS=3
TON_NETWORK=testnet
TON_API_KEY=
TON_ENDPOINT=
TON_DEPLOY_MODE=stub
TON_DEPLOYER_MNEMONIC=
TON_GRM_JETTON_MASTER=
TON_POLL_INTERVAL_MS=2000

# R7.0C — In production/staging: use strong unique secrets (not these examples).
# DEVELOPER_AUTH_ENABLED must remain true; insecure defaults are rejected.
DEVELOPER_AUTH_ENABLED=true
DEVELOPER_AUTH_SECRET=change-me-developer-console-secret
DEVELOPER_AUTH_USERNAME=developer
DEVELOPER_AUTH_PASSWORD=developer
DEVELOPER_AUTH_ACCESS_TTL_SECONDS=900
DEVELOPER_AUTH_REFRESH_TTL_SECONDS=28800
