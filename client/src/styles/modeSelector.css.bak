.modeSelector{

    display:flex;

    gap:20px;

    margin-bottom:30px;

}

.modeCard{

    flex:1;

    background:white;

    border:2px solid #D6E3F1;

    border-radius:12px;

    padding:24px;

    cursor:pointer;

    transition:.2s;

    text-align:center;

}

.modeCard:hover{

    border-color:#2563EB;

    transform:translateY(-2px);

}

.modeCard.active{

    background:#EFF6FF;

    border-color:#2563EB;

    box-shadow:0 6px 16px rgba(37,99,235,.18);

}

.modeTitle{

    font-size:18px;

    font-weight:700;

    margin-bottom:10px;

}

.modeText{

    color:#666;

    font-size:14px;

}